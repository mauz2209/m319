/*imperative program*/void main() {
	climb(length());
}
int length(){
	int length = 0;
	while(vornFrei()){
		if(kornDa()){
			length += count();
		}
		vor();
	}
	return length;
}

void rechtsUm(){
	linksUm();
	linksUm();
	linksUm();
}

int count(){
	int count = 0;
	while(kornDa()){
		nimm();
		count++;
	}
	return count;
}

void climb(int steps){
	int maxLength = 6;
	if(steps <= maxLength){
		for(int i = 0; i < steps; i++){
			linksUm();
			vor();
			rechtsUm();
			vor();
		}
	}
}