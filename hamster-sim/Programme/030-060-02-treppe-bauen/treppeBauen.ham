/*imperative program*/void main() {
    treppe();
}

void walk(int max){
	for (int i = 0; i < max; i++){
   		if(vornFrei()){
   			vor();
   		}
   	}
}

void geben(int koerner){
	for (int i = 0; i < koerner; i++){
		gib();
	} 
} 

void treppe(){
	geben(1);
	for (int i = 2; vornFrei(); i++){
		walk(1);
		geben(i);
	}
}